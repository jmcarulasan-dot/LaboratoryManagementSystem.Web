@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using LaboratoryManagementSystem.Web.Layout
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api
@inject NavigationManager Navigation

@if (_checking)
{
    <div class="auth-check">
        <MudProgressCircular Indeterminate="true" Color="Color.Error" Size="Size.Large" />
        <MudText Class="muted mt-4">Checking your admin session…</MudText>
    </div>
}
else if (_authorized)
{
    <RouteView RouteData="@RouteData" DefaultLayout="@typeof(MainLayout)" />
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    private bool _checking = true;
    private bool _authorized;

    protected override async Task OnInitializedAsync()
    {
        try { _authorized = await Api.HasAdminSessionAsync(); }
        catch { _authorized = false; }
        finally { _checking = false; }

        if (!_authorized)
            Navigation.NavigateTo("/login", replace: true);
    }
}
