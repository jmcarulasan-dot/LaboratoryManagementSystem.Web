@page "/settings"
@inject ApiClient Api
@inject ISnackbar Snackbar

<div class="page-wrap">
    <PageHeader Title="Settings" Subtitle="Manage your account and system preferences" />

    <div class="dash-grid" style="grid-template-columns:240px minmax(0,1fr)">
        <div class="lms-card" style="padding:10px">
            <MudNavMenu>
                <MudNavLink OnClick="@(() => _tab = "profile")" Icon="@Icons.Material.Outlined.Person" Class="@(_tab == "profile" ? "mud-nav-link-active" : "")">Profile</MudNavLink>
                <MudNavLink OnClick="@(() => _tab = "security")" Icon="@Icons.Material.Outlined.Lock" Class="@(_tab == "security" ? "mud-nav-link-active" : "")">Security</MudNavLink>
            </MudNavMenu>
        </div>

        <div class="lms-card">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Error" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_tab == "profile")
            {
                <h2 class="lms-card-title" style="margin-bottom:16px">Profile Information</h2>
                <div class="form-grid">
                    <MudTextField @bind-Value="_fullName" Label="Full Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_email" Label="Email Address" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Must be a @@gmail.com address." />
                    <MudTextField Value="@("System Administrator")" Label="Role" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_companyId" Label="Company ID" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div class="form-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Reset">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveProfile">Save Changes</MudButton>
                </div>
            }
            else
            {
                <h2 class="lms-card-title" style="margin-bottom:16px">Change Password</h2>
                <div class="form-grid">
                    <MudTextField @bind-Value="_password" Label="New Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="At least 8 characters with upper and lower case letters." />
                    <MudTextField @bind-Value="_confirm" Label="Confirm New Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div class="form-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SavePassword">Update Password</MudButton>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _tab = "profile";
    private bool _loading = true, _busy;
    private string? _error;
    private int _adminId;
    private string _fullName = "", _email = "", _companyId = "", _password = "", _confirm = "";
    private string _origName = "", _origEmail = "", _origCompany = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await Api.GetAdminProfileAsync();
            if (profile.ValueKind != JsonValueKind.Object)
            {
                _error = "Could not load your profile. Sign in again and check that the API is running.";
                return;
            }
            _adminId = JsonRow.Int(profile, "adminID");
            _origName = JsonRow.Str(profile, "fullName", "");
            _origEmail = JsonRow.Str(profile, "email", "");
            _origCompany = JsonRow.Str(profile, "companyID", "");
            Reset();
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private void Reset()
    {
        _fullName = _origName;
        _email = _origEmail;
        _companyId = _origCompany;
    }

    private async Task SaveProfile()
    {
        if (_adminId <= 0) return;
        _busy = true;
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/admin/{_adminId}",
                new { companyID = _companyId.Trim(), fullName = _fullName.Trim(), email = _email.Trim() });
            if (ok)
            {
                _origName = _fullName.Trim();
                _origEmail = _email.Trim();
                _origCompany = _companyId.Trim();
                Snackbar.Add("Profile updated. If you changed your Company ID, use the new one the next time you sign in.", Severity.Success);
            }
            else Snackbar.Add(message, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task SavePassword()
    {
        if (_password != _confirm) { Snackbar.Add("The two passwords do not match.", Severity.Warning); return; }
        if (_password.Length < 8 || !_password.Any(char.IsUpper) || !_password.Any(char.IsLower))
        {
            Snackbar.Add("Password needs at least 8 characters with upper and lower case letters.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/admin/{_adminId}/password", new { password = _password });
            Snackbar.Add(ok ? "Password updated." : message, ok ? Severity.Success : Severity.Error);
            if (ok) { _password = ""; _confirm = ""; }
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }
}
