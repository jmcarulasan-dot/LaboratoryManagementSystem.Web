@page "/"
@inject ApiClient Api

<div class="page-wrap">
    <PageHeader Title="Dashboard" Subtitle="Welcome back, Administrator!" />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" />
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-tile">
                <span class="pill pill-green stat-live">Live</span>
                <div class="stat-icon"><MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" /></div>
                <div class="stat-value">@_active</div>
                <div class="stat-label">Active Sessions Now</div>
            </div>
            <div class="stat-tile">
                <div class="stat-icon"><MudIcon Icon="@Icons.Material.Outlined.Computer" Size="Size.Small" /></div>
                <div class="stat-value">@_pcs</div>
                <div class="stat-label">Total Computers in Lab</div>
            </div>
            <div class="stat-tile">
                <div class="stat-icon"><MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" Size="Size.Small" /></div>
                <div class="stat-value">@_students</div>
                <div class="stat-label">Total Students Registered</div>
            </div>
            <div class="stat-tile">
                <div class="stat-icon"><MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" /></div>
                <div class="stat-value">@_logins</div>
                <div class="stat-label">Today's Logins</div>
            </div>
        </div>

        <div class="dash-grid">
            <div class="lms-card">
                <div class="lms-card-head">
                    <h2 class="lms-card-title">Active Sessions</h2>
                    <MudLink Href="/sessions" Color="Color.Error" Underline="Underline.None">View All Sessions →</MudLink>
                </div>
                @if (_activeSessions.Count == 0)
                {
                    <div class="empty">No active sessions right now.</div>
                }
                else
                {
                    <div class="lms-table-wrap">
                        <table class="lms-table">
                            <thead><tr><th>Student ID</th><th>Name</th><th>PC</th><th>Time In</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var row in _activeSessions)
                                {
                                    <tr>
                                        <td class="mono">@JsonRow.Str(row, "studentNo")</td>
                                        <td>@JsonRow.Str(row, "studentName")</td>
                                        <td class="mono">@JsonRow.Str(row, "pcName")</td>
                                        <td>@JsonRow.Time(JsonRow.Date(row, "timeIn"))</td>
                                        <td><span class="pill pill-green">Active</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div>
                <div class="lms-card" style="margin-bottom:20px">
                    <h2 class="lms-card-title" style="margin-bottom:14px">Quick Actions</h2>
                    <MudStack Spacing="2">
                        <MudButton Href="/students/add" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add New Student</MudButton>
                        <MudButton Href="/rooms-pcs/add" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Computer">Add New Computer</MudButton>
                        <MudButton Href="/vouchers" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ConfirmationNumber">Generate Vouchers</MudButton>
                    </MudStack>
                </div>
                <div class="lms-card">
                    <h2 class="lms-card-title" style="margin-bottom:6px">System Overview</h2>
                    <table class="lms-table">
                        <tbody>
                            <tr><td>System Status</td><td style="text-align:right"><span class="pill @(_error is null ? "pill-green" : "pill-red")">@(_error is null ? "Online" : "Offline")</span></td></tr>
                            <tr><td>Database</td><td style="text-align:right"><span class="pill @(_dashboardOk ? "pill-green" : "pill-red")">@(_dashboardOk ? "Connected" : "Unavailable")</span></td></tr>
                            <tr><td>Available PCs</td><td style="text-align:right">@_availablePcs of @_pcs</td></tr>
                            <tr><td>Ready Vouchers</td><td style="text-align:right">@_vouchers</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _dashboardOk;
    private string? _error;
    private int _active, _pcs, _students, _logins, _availablePcs, _vouchers;
    private List<JsonElement> _activeSessions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dashboard = await Api.GetAsync<JsonElement>("api/admin/dashboard");
            if (dashboard.ValueKind == JsonValueKind.Object)
            {
                _dashboardOk = true;
                _active = JsonRow.Int(dashboard, "activeSessions");
                _pcs = JsonRow.Int(dashboard, "totalPCs");
                _students = JsonRow.Int(dashboard, "totalStudents");
                _availablePcs = JsonRow.Int(dashboard, "availablePCs");
                _vouchers = JsonRow.Int(dashboard, "activeVouchers");
            }
            else
            {
                _error = "Dashboard data could not be loaded. Sign in again and check that the API and database are running.";
            }

            var sessions = await Api.GetListAsync("api/admin/sessions");
            if (sessions is not null)
            {
                _logins = sessions.Count(s => JsonRow.Date(s, "timeIn")?.Date == DateTime.Today);
                _activeSessions = sessions
                    .Where(s => JsonRow.Find(s, "timeOut") is not { ValueKind: not JsonValueKind.Null })
                    .Take(5)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to reach the LMS API ({ex.Message}). Start the API and sign in.";
        }
        finally
        {
            _loading = false;
        }
    }
}
