@page "/rooms-pcs"
@inject ApiClient Api
@inject ISnackbar Snackbar

<div class="page-wrap">
    <PageHeader Title="Computer Management" Subtitle="Monitor and manage lab PCs">
        <MudButton Href="/rooms-pcs/add" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add Computer</MudButton>
    </PageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_error</MudAlert>
    }
    else
    {
        <div class="chip-row">
            <span class="count-chip pill-green">@Count("Available") Available</span>
            <span class="count-chip pill-red">@Count("In use") In Use</span>
            <span class="count-chip pill-amber">@Count("Maintenance") Maintenance</span>
            <span style="flex:1"></span>
            <MudSelect T="int" @bind-Value="_roomFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px" Label="Room">
                <MudSelectItem T="int" Value="0">All rooms</MudSelectItem>
                @foreach (var room in _rooms)
                {
                    <MudSelectItem T="int" Value="@room.Id">@room.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (Visible.Count == 0)
        {
            <div class="lms-card empty">No computers registered yet. Use "Add Computer" to register one.</div>
        }
        else
        {
            <div class="pc-grid">
                @foreach (var pc in Visible)
                {
                    <div class="pc-card">
                        <span class="pc-dot @DotClass(pc.State)"></span>
                        <div class="pc-name">@pc.Name</div>
                        <div class="pc-meta">@pc.Detail</div>
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                            <span class="pill @PillClass(pc.State)">@pc.State</span>
                            @if (pc.State != "In use")
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="@(() => Toggle(pc))">@(pc.State == "Maintenance" ? "Mark available" : "Set maintenance")</MudButton>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="muted" style="text-align:center;font-size:12px;margin-top:20px">Showing @Visible.Count of @_pcs.Count computers</div>
        }
    }
</div>

@code {
    private sealed record RoomView(int Id, string Name);
    private sealed record PcView(int Id, int RoomId, string Name, string Room, string State, string Detail);

    private bool _loading = true;
    private string? _error;
    private int _roomFilter;
    private List<RoomView> _rooms = new();
    private List<PcView> _pcs = new();

    private List<PcView> Visible => _roomFilter == 0 ? _pcs : _pcs.Where(p => p.RoomId == _roomFilter).ToList();
    private int Count(string state) => Visible.Count(p => p.State == state);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var rooms = await Api.GetListAsync("api/rooms");
            var pcs = await Api.GetListAsync("api/pcs");
            var sessions = await Api.GetListAsync("api/admin/sessions");
            if (rooms is null || pcs is null)
            {
                _error = "Could not load computers. Sign in again and check that the API and database are running.";
                return;
            }

            _rooms = rooms.Select(r => new RoomView(JsonRow.Int(r, "roomID"), JsonRow.Str(r, "roomName"))).ToList();
            var roomNames = _rooms.ToDictionary(r => r.Id, r => r.Name);

            var inUse = new Dictionary<int, JsonElement>();
            foreach (var s in sessions ?? new List<JsonElement>())
            {
                var timeOut = JsonRow.Find(s, "timeOut");
                if (timeOut is { ValueKind: not JsonValueKind.Null }) continue;
                inUse[JsonRow.Int(s, "pcid")] = s;
            }

            _pcs = pcs
                .Where(p => !JsonRow.Find(p, "isActive").HasValue || JsonRow.Bool(p, "isActive"))
                .Select(p =>
                {
                    var id = JsonRow.Int(p, "pcid");
                    var roomId = JsonRow.Int(p, "roomID");
                    var room = roomNames.TryGetValue(roomId, out var name) ? name : "Room";
                    string state, detail;
                    if (inUse.TryGetValue(id, out var session))
                    {
                        state = "In use";
                        detail = $"{JsonRow.Str(session, "studentName")} · {JsonRow.Time(JsonRow.Date(session, "timeIn"))}";
                    }
                    else if (JsonRow.Str(p, "pcStatus") == "Under Maintenance")
                    {
                        state = "Maintenance";
                        detail = $"{room} · under maintenance";
                    }
                    else
                    {
                        state = "Available";
                        detail = room;
                    }
                    return new PcView(id, roomId, JsonRow.Str(p, "pcName"), room, state, detail);
                })
                .OrderBy(p => p.Room).ThenBy(p => p.Name)
                .ToList();
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task Toggle(PcView pc)
    {
        var target = pc.State == "Maintenance" ? "Available" : "Under Maintenance";
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/pcs/{pc.Id}/status", target);
            Snackbar.Add(ok ? $"{pc.Name} is now {target.ToLowerInvariant()}." : message, ok ? Severity.Success : Severity.Error);
            if (ok) await Load();
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
    }

    private static string DotClass(string state) => state switch { "In use" => "dot-red", "Maintenance" => "dot-amber", _ => "dot-green" };
    private static string PillClass(string state) => state switch { "In use" => "pill-red", "Maintenance" => "pill-amber", _ => "pill-green" };
}
