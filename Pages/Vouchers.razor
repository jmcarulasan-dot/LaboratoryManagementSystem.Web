@page "/vouchers"
<div class="page-wrap">
 <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6"><div><MudText Typo="Typo.h4" Class="page-title">Vouchers</MudText><MudText Class="muted mt-1">Generate batches of one-time laboratory access vouchers.</MudText></div><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowDemoMessage">Generate vouchers</MudButton></MudStack>
 <MudPaper Elevation="0" Class="content-card pa-4"><MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-4"><MudTextField @bind-Value="_search" Placeholder="Search records..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:340px"/><MudSpacer/><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload">Export</MudButton></MudStack>
 <MudTable Items="FilteredRows" Hover Dense Elevation="0"><HeaderContent>@foreach(var col in Columns){<MudTh>@col</MudTh>}</HeaderContent><RowTemplate>@foreach(var value in context){<MudTd>@if(value=="Available"||value=="Active"||value=="Read"||value=="Completed"){<MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@value</MudChip>}else if(value=="Suspended"||value=="Under Maintenance"||value=="Unread"){<MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@value</MudChip>}else if(value=="In Use"){<MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@value</MudChip>}else{@value} </MudTd>}</RowTemplate></MudTable></MudPaper>
 <MudText Typo="Typo.caption" Class="muted mt-4">Design preview only — sample records. API/database actions are not connected yet.</MudText>
</div>
@code { private string _search=""; private string[] Columns=new[]{"Voucher Code", "Assigned Student", "Created", "Expires", "Status"}; private List<string[]> Rows=new(){new[] { "A7K2-X9PQ", "Not assigned", "Oct 09, 2026", "10:00 AM", "Available" },
        new[] { "B4M8-P2RT", "Juan Dela Cruz", "Oct 09, 2026", "10:00 AM", "Used" },
        new[] { "C5N7-W3KL", "Not assigned", "Oct 09, 2026", "11:00 AM", "Available" }}; private IEnumerable<string[]> FilteredRows=>string.IsNullOrWhiteSpace(_search)?Rows:Rows.Where(r=>string.Join(" ",r).Contains(_search,StringComparison.OrdinalIgnoreCase)); [Inject] private ISnackbar Snackbar{get;set;}=default!; private void ShowDemoMessage()=>Snackbar.Add("Voucher batch generation is a design placeholder. API generation is not connected yet.",Severity.Info); private void ShowExportMessage()=>Snackbar.Add("Export is not available in the design preview yet.",Severity.Info); }
