@page "/rooms-pcs"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api

<div class="page-wrap">
    <MudText Typo="Typo.h4" Class="page-title">Rooms & PCs</MudText>
    <MudText Class="muted mt-1 mb-6">Live records from the LMS database.</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert>
    }
    <MudCard Class="content-card pa-5 mb-5" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-4">Rooms</MudText>
        <ApiDataTable Items="_rooms" Columns="_roomColumns" EmptyMessage="No rooms are in the database yet." />
    </MudCard>
    <MudCard Class="content-card pa-5" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-4">Computers</MudText>
        <ApiDataTable Items="_pcs" Columns="_pcColumns" EmptyMessage="No computers are in the database yet." />
    </MudCard>
</div>

@code {
    private readonly string[] _roomColumns = ["RoomID", "RoomName", "IsActive"];
    private readonly string[] _pcColumns = ["PCID", "PCName", "RoomID", "PCStatus", "IsActive"];
    private IReadOnlyCollection<JsonElement> _rooms = Array.Empty<JsonElement>();
    private IReadOnlyCollection<JsonElement> _pcs = Array.Empty<JsonElement>();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rooms = await Api.GetAsync<JsonElement>("api/rooms");
            var pcs = await Api.GetAsync<JsonElement>("api/pcs");
            if (rooms.ValueKind != JsonValueKind.Array || pcs.ValueKind != JsonValueKind.Array)
                _error = "Rooms and computers could not be loaded. Check your admin session and the API/database connection.";
            else
            {
                _rooms = rooms.EnumerateArray().ToArray();
                _pcs = pcs.EnumerateArray().ToArray();
            }
        }
        catch (Exception ex) { _error = $"Unable to connect to the LMS API: {ex.Message}"; }
        finally { _loading = false; }
    }
}
