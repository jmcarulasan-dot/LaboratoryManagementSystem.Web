@page "/vouchers"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api

<div class="page-wrap">
    <MudText Typo="Typo.h4" Class="page-title">Vouchers</MudText>
    <MudText Class="muted mt-1 mb-6">Vouchers currently recorded in the LMS database.</MudText>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" /> }
    else if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert> }
    <MudPaper Elevation="0" Class="content-card pa-5">
        <ApiDataTable Items="_rows" Columns="_columns" EmptyMessage="No vouchers are in the database yet." />
    </MudPaper>
</div>

@code {
    private readonly string[] _columns = ["VoucherCode", "StudentNo", "StudentName", "Status", "CreatedAt", "ExpiresAt", "UsedAt"];
    private IReadOnlyCollection<JsonElement> _rows = Array.Empty<JsonElement>();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetAsync<JsonElement>("api/admin/vouchers");
            if (result.ValueKind != JsonValueKind.Array) _error = "Vouchers could not be loaded. Check your admin session and the API/database connection.";
            else _rows = result.EnumerateArray().ToArray();
        }
        catch (Exception ex) { _error = $"Unable to connect to the LMS API: {ex.Message}"; }
        finally { _loading = false; }
    }
}
