@page "/"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api
@inject NavigationManager Navigation

<div class="page-wrap dashboard-page">
    <div class="dashboard-heading">
        <div>
            <div class="dashboard-eyebrow"><span></span> LABORATORY MANAGEMENT</div>
            <MudText Typo="Typo.h4" Class="page-title">Dashboard</MudText>
            <MudText Class="muted mt-1">A clear view of your campus laboratory activity.</MudText>
        </div>
        <div class="dashboard-date">
            <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />
            <span>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            @_error <MudButton Href="/login" Color="Color.Primary" Size="Size.Small">Sign in</MudButton>
        </MudAlert>
    }
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" />
        <MudText Class="muted">Loading dashboard data...</MudText>
    }
    else if (_dashboard.HasValue)
    {
        <MudGrid Spacing="3" Class="dashboard-metrics">
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Class="stat-card dashboard-stat" Elevation="0">
                    <div class="stat-topline"><span class="stat-icon students"><MudIcon Icon="@Icons.Material.Outlined.Groups" /></span><span class="stat-label">TOTAL STUDENTS</span></div>
                    <MudText Class="stat-number">@Metric("totalStudents", "TotalStudents", "studentCount", "StudentCount")</MudText>
                    <div class="stat-footnote">Student accounts in the system</div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Class="stat-card dashboard-stat" Elevation="0">
                    <div class="stat-topline"><span class="stat-icon computers"><MudIcon Icon="@Icons.Material.Outlined.Computer" /></span><span class="stat-label">TOTAL COMPUTERS</span></div>
                    <MudText Class="stat-number">@Metric("totalPCs", "TotalPCs", "pcCount", "PCCount", "totalComputers")</MudText>
                    <div class="stat-footnote">Computers across all lab rooms</div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Class="stat-card dashboard-stat" Elevation="0">
                    <div class="stat-topline"><span class="stat-icon sessions"><MudIcon Icon="@Icons.Material.Outlined.Schedule" /></span><span class="stat-label">ACTIVE SESSIONS</span></div>
                    <MudText Class="stat-number">@Metric("activeSessions", "ActiveSessions", "sessionCount", "SessionCount")</MudText>
                    <div class="stat-footnote">Students currently using the lab</div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Class="stat-card dashboard-stat" Elevation="0">
                    <div class="stat-topline"><span class="stat-icon vouchers"><MudIcon Icon="@Icons.Material.Outlined.Login" /></span><span class="stat-label">TODAY'S LOGINS</span></div>
                    <MudText Class="stat-number">@_todayLogins</MudText>
                    <div class="stat-footnote">Lab sessions started today</div>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="dashboard-main-grid">
            <MudItem xs="12" lg="8">
                <MudCard Class="content-card dashboard-overview" Elevation="0">
                    <div class="dashboard-card-heading">
                        <div>
                            <MudText Typo="Typo.h6" Class="dashboard-card-title">System overview</MudText>
                            <MudText Typo="Typo.body2" Class="muted">Current totals reported by the LMS API</MudText>
                        </div>
                        <span class="live-indicator"><i></i> LIVE DATA</span>
                    </div>
                    @if (_summaryRows.Count == 0)
                    {
                        <div class="dashboard-empty">No additional summary metrics were returned.</div>
                    }
                    else
                    {
                        <div class="summary-grid">
                            @foreach (var row in _summaryRows)
                            {
                                <div class="summary-item">
                                    <span class="summary-label">@DisplayName(row.Key)</span>
                                    <span class="summary-value">@row.Value</span>
                                </div>
                            }
                        </div>
                    }
                </MudCard>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudCard Class="content-card dashboard-actions" Elevation="0">
                    <div class="dashboard-card-heading">
                        <div>
                            <MudText Typo="Typo.h6" Class="dashboard-card-title">Quick access</MudText>
                            <MudText Typo="Typo.body2" Class="muted">Common administration tasks</MudText>
                        </div>
                    </div>
                    <div class="action-list">
                        <a class="dashboard-action" href="/students"><span class="action-icon"><MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" /></span><span><b>Students</b><small>Manage student accounts</small></span><MudIcon Class="action-arrow" Icon="@Icons.Material.Outlined.ArrowForward" /></a>
                        <a class="dashboard-action" href="/rooms-pcs"><span class="action-icon"><MudIcon Icon="@Icons.Material.Outlined.Devices" /></span><span><b>Rooms &amp; computers</b><small>Review lab resources</small></span><MudIcon Class="action-arrow" Icon="@Icons.Material.Outlined.ArrowForward" /></a>
                        <a class="dashboard-action" href="/sessions"><span class="action-icon"><MudIcon Icon="@Icons.Material.Outlined.AccessTime" /></span><span><b>Lab sessions</b><small>View attendance activity</small></span><MudIcon Class="action-arrow" Icon="@Icons.Material.Outlined.ArrowForward" /></a>
                        <a class="dashboard-action" href="/reports"><span class="action-icon"><MudIcon Icon="@Icons.Material.Outlined.Assessment" /></span><span><b>Reports</b><small>Explore usage records</small></span><MudIcon Class="action-arrow" Icon="@Icons.Material.Outlined.ArrowForward" /></a>
                    </div>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard Class="content-card dashboard-sessions" Elevation="0">
            <div class="dashboard-card-heading">
                <div>
                    <MudText Typo="Typo.h6" Class="dashboard-card-title">Recent lab sessions</MudText>
                    <MudText Typo="Typo.body2" Class="muted">The latest session records from your database</MudText>
                </div>
                <MudButton Href="/sessions" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward">View all</MudButton>
            </div>
            @if (_sessions.Count == 0)
            {
                <div class="dashboard-empty">No lab sessions have been recorded yet.</div>
            }
            else
            {
                <MudTable Items="_sessions" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent><MudTh>Student</MudTh><MudTh>Student number</MudTh><MudTh>Room / computer</MudTh><MudTh>Time in</MudTh><MudTh>Status</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@Read(context, "fullName", "FullName", "studentName", "StudentName")</MudTd>
                        <MudTd>@Read(context, "studentNo", "StudentNo")</MudTd>
                        <MudTd>@Read(context, "roomName", "RoomName", "pcName", "PCName", "location", "Location")</MudTd>
                        <MudTd>@Read(context, "timeIn", "TimeIn", "startTime", "StartTime", "createdAt", "CreatedAt")</MudTd>
                        <MudTd>@Read(context, "status", "Status", "sessionStatus", "SessionStatus")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCard>
    }
</div>

@code {
    private JsonElement? _dashboard;
    private List<JsonElement> _sessions = new();
    private int _todayLogins;
    private List<KeyValuePair<string, string>> _summaryRows = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await Api.GetAsync<JsonElement>("api/admin/dashboard");
            if (!_dashboard.HasValue || _dashboard.Value.ValueKind == JsonValueKind.Undefined)
            {
                _error = "Dashboard data could not be loaded. Please sign in with an admin account and check that the API/database are running.";
                return;
            }

            var root = _dashboard.Value;
            if (root.ValueKind == JsonValueKind.Object)
            {
                var primaryMetrics = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                {
                    "totalStudents", "totalPCs", "totalComputers", "activeSessions", "activeVouchers",
                    "studentCount", "pcCount", "sessionCount", "voucherCount",
                    "TotalStudents", "TotalPCs", "TotalComputers", "ActiveSessions", "ActiveVouchers",
                    "StudentCount", "PCCount", "SessionCount", "VoucherCount",
                    "availableVouchers", "AvailableVouchers"
                };
                _summaryRows = root.EnumerateObject()
                    .Where(p => !primaryMetrics.Contains(p.Name))
                    .Select(p => new KeyValuePair<string, string>(p.Name, Format(p.Value)))
                    .ToList();
            }

            var sessions = await Api.GetAsync<JsonElement>("api/admin/sessions");
            if (sessions.ValueKind == JsonValueKind.Array)
            {
                var allSessions = sessions.EnumerateArray().ToList();
                _todayLogins = allSessions.Count(session =>
                    DateTime.TryParse(Read(session, "timeIn", "TimeIn", "startTime", "StartTime"), out var timeIn) &&
                    timeIn.Date == DateTime.Today);
                _sessions = allSessions.Take(8).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to connect to the LMS API ({ex.Message}). Start the API and sign in.";
        }
        finally { _loading = false; }
    }

    private string Metric(params string[] names)
    {
        if (!_dashboard.HasValue || _dashboard.Value.ValueKind != JsonValueKind.Object) return "—";
        foreach (var name in names)
            if (_dashboard.Value.TryGetProperty(name, out var value)) return Format(value);
        return "—";
    }

    private static string Read(JsonElement row, params string[] names)
    {
        if (row.ValueKind != JsonValueKind.Object) return "—";
        foreach (var name in names)
            if (row.TryGetProperty(name, out var value)) return Format(value);
        return "—";
    }

    private static string DisplayName(string key)
    {
        var spaced = System.Text.RegularExpressions.Regex.Replace(key, "([a-z0-9])([A-Z])", "$1 $2");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(spaced.Replace("_", " ").Replace("-", " "));
    }

    private static string Format(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => "—",
        JsonValueKind.String => value.GetString() ?? "—",
        JsonValueKind.Object => "Details",
        JsonValueKind.Array => $"{value.GetArrayLength()} items",
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        _ => value.ToString()
    };
}
