@page "/"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api
@inject NavigationManager Navigation

<div class="page-wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="page-title">Dashboard</MudText>
            <MudText Class="muted mt-1">Computer Laboratory System overview</MudText>
        </div>
        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">Admin sign in</MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            @_error <MudButton Href="/login" Color="Color.Primary" Size="Size.Small">Sign in</MudButton>
        </MudAlert>
    }
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" />
        <MudText Class="muted">Loading dashboard from the LMS API...</MudText>
    }
    else if (_dashboard.HasValue)
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="3"><MudCard Class="stat-card pa-4" Elevation="0"><MudText Class="muted">Total Students</MudText><MudText Class="stat-number mt-3">@Metric("totalStudents", "TotalStudents", "studentCount", "StudentCount")</MudText><MudText Typo="Typo.caption" Class="muted">Live API value</MudText></MudCard></MudItem>
            <MudItem xs="12" sm="6" lg="3"><MudCard Class="stat-card pa-4" Elevation="0"><MudText Class="muted">Registered PCs</MudText><MudText Class="stat-number mt-3">@Metric("totalPCs", "TotalPCs", "pcCount", "PCCount", "totalComputers")</MudText><MudText Typo="Typo.caption" Class="muted">Live API value</MudText></MudCard></MudItem>
            <MudItem xs="12" sm="6" lg="3"><MudCard Class="stat-card pa-4" Elevation="0"><MudText Class="muted">Active Sessions</MudText><MudText Class="stat-number mt-3">@Metric("activeSessions", "ActiveSessions", "sessionCount", "SessionCount")</MudText><MudText Typo="Typo.caption" Class="muted">Live API value</MudText></MudCard></MudItem>
            <MudItem xs="12" sm="6" lg="3"><MudCard Class="stat-card pa-4" Elevation="0"><MudText Class="muted">Available Vouchers</MudText><MudText Class="stat-number mt-3">@Metric("availableVouchers", "AvailableVouchers", "voucherCount", "VoucherCount")</MudText><MudText Typo="Typo.caption" Class="muted">Live API value</MudText></MudCard></MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-2">
            <MudItem xs="12" lg="7">
                <MudCard Class="content-card pa-5" Elevation="0">
                    <MudText Typo="Typo.h6" Style="font-weight:700">System Overview</MudText>
                    <MudText Typo="Typo.body2" Class="muted mb-4">Summary returned by the API</MudText>
                    <MudTable Items="_summaryRows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent><MudTh>Metric</MudTh><MudTh>Value</MudTh></HeaderContent>
                        <RowTemplate><MudTd>@context.Key</MudTd><MudTd>@context.Value</MudTd></RowTemplate>
                    </MudTable>
                </MudCard>
            </MudItem>
            <MudItem xs="12" lg="5">
                <MudCard Class="content-card pa-5" Elevation="0">
                    <MudText Typo="Typo.h6" Style="font-weight:700">Quick Actions</MudText>
                    <MudStack Spacing="2" Class="mt-4">
                        <MudButton Href="/students" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.People">User Management</MudButton>
                        <MudButton Href="/rooms-pcs" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Computer">Computer Management</MudButton>
                        <MudButton Href="/sessions" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Schedule">Lab Sessions</MudButton>
                        <MudButton Href="/vouchers" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ConfirmationNumber">Vouchers</MudButton>
                        <MudButton Href="/reports" FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.BarChart">Reports</MudButton>
                    </MudStack>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard Class="content-card pa-5 mt-5" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <div><MudText Typo="Typo.h6" Style="font-weight:700">Lab Sessions</MudText><MudText Typo="Typo.body2" Class="muted">Records loaded from the API</MudText></div>
                <MudButton Href="/sessions" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">View all</MudButton>
            </MudStack>
            @if (_sessions.Count == 0)
            {
                <MudText Class="muted pa-3">The API returned no session records, or its response format needs mapping.</MudText>
            }
            else
            {
                <MudTable Items="_sessions" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent><MudTh>Student</MudTh><MudTh>Student No.</MudTh><MudTh>Room / PC</MudTh><MudTh>Time In</MudTh><MudTh>Status</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@Read(context, "fullName", "FullName", "studentName", "StudentName")</MudTd>
                        <MudTd>@Read(context, "studentNo", "StudentNo")</MudTd>
                        <MudTd>@Read(context, "roomName", "RoomName", "pcName", "PCName", "location", "Location")</MudTd>
                        <MudTd>@Read(context, "timeIn", "TimeIn", "startTime", "StartTime", "createdAt", "CreatedAt")</MudTd>
                        <MudTd>@Read(context, "status", "Status", "sessionStatus", "SessionStatus")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCard>
    }
</div>

@code {
    private JsonElement? _dashboard;
    private List<JsonElement> _sessions = new();
    private List<KeyValuePair<string, string>> _summaryRows = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await Api.GetAsync<JsonElement>("api/admin/dashboard");
            if (!_dashboard.HasValue || _dashboard.Value.ValueKind == JsonValueKind.Undefined)
            {
                _error = "Dashboard data could not be loaded. Please sign in with an admin account and check that the API/database are running.";
                return;
            }

            var root = _dashboard.Value;
            if (root.ValueKind == JsonValueKind.Object)
                _summaryRows = root.EnumerateObject().Select(p => new KeyValuePair<string, string>(p.Name, Format(p.Value))).ToList();

            var sessions = await Api.GetAsync<JsonElement>("api/admin/sessions");
            if (sessions.ValueKind == JsonValueKind.Array)
                _sessions = sessions.EnumerateArray().ToList();
        }
        catch (Exception ex)
        {
            _error = $"Unable to connect to the LMS API ({ex.Message}). Start the API and sign in.";
        }
        finally { _loading = false; }
    }

    private string Metric(params string[] names)
    {
        if (!_dashboard.HasValue || _dashboard.Value.ValueKind != JsonValueKind.Object) return "—";
        foreach (var name in names)
            if (_dashboard.Value.TryGetProperty(name, out var value)) return Format(value);
        return "—";
    }

    private static string Read(JsonElement row, params string[] names)
    {
        if (row.ValueKind != JsonValueKind.Object) return "—";
        foreach (var name in names)
            if (row.TryGetProperty(name, out var value)) return Format(value);
        return "—";
    }

    private static string Format(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => "—",
        JsonValueKind.String => value.GetString() ?? "—",
        JsonValueKind.Object => "(object)",
        JsonValueKind.Array => $"{value.GetArrayLength()} items",
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        _ => value.ToString()
    };
}
