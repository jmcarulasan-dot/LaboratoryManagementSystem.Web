@page "/"
<div class="page-wrap">
 <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6"><div><MudText Typo="Typo.h4" Class="page-title">Dashboard</MudText><MudText Class="muted mt-1">Here’s what’s happening in your laboratories today.</MudText></div><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download">Export summary</MudButton></MudStack>
 <MudGrid Spacing="3">
 @foreach(var s in Stats){<MudItem xs="12" sm="6" lg="3"><MudCard Elevation="0" Class="stat-card pa-4"><MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><MudText Typo="Typo.body2" Class="muted">@s.Label</MudText><MudAvatar Color="Color.Primary"><MudIcon Icon="@s.Icon"/></MudAvatar></MudStack><MudText Class="stat-number mt-3">@s.Value</MudText><MudText Typo="Typo.caption" Class="muted mt-1">@s.Note</MudText></MudCard></MudItem>}
 </MudGrid>
 <MudGrid Class="mt-2" Spacing="3"><MudItem xs="12" lg="7"><MudCard Elevation="0" Class="content-card pa-5"><MudText Typo="Typo.h6" Style="font-weight:700">PC availability</MudText><MudText Typo="Typo.body2" Class="muted mb-4">Current computer status across all rooms</MudText><MudGrid Spacing="2"><MudItem xs="4"><MudPaper Elevation="0" Class="pa-4" Style="background:#ecfdf5;border-radius:12px"><MudText Typo="Typo.caption" Color="Color.Success">Available</MudText><MudText Typo="Typo.h4">27</MudText></MudPaper></MudItem><MudItem xs="4"><MudPaper Elevation="0" Class="pa-4" Style="background:#fff7ed;border-radius:12px"><MudText Typo="Typo.caption" Color="Color.Warning">In Use</MudText><MudText Typo="Typo.h4">8</MudText></MudPaper></MudItem><MudItem xs="4"><MudPaper Elevation="0" Class="pa-4" Style="background:#fef2f2;border-radius:12px"><MudText Typo="Typo.caption" Color="Color.Error">Maintenance</MudText><MudText Typo="Typo.h4">3</MudText></MudPaper></MudItem></MudGrid><MudProgressLinear Value="71" Color="Color.Success" Rounded Size="Size.Large" Class="mt-5"/><MudText Typo="Typo.caption" Class="muted mt-2">71% of registered computers are available (sample data).</MudText></MudCard></MudItem>
 <MudItem xs="12" lg="5"><MudCard Elevation="0" Class="content-card pa-5"><MudText Typo="Typo.h6" Style="font-weight:700">Recent activity</MudText><MudText Typo="Typo.body2" Class="muted mb-4">Latest events from the laboratory</MudText>@foreach(var a in Activity){<MudStack Row Spacing="3" Class="mb-4" AlignItems="AlignItems.Start"><MudAvatar Size="Size.Small" Color="@a.Color"><MudIcon Icon="@a.Icon" Size="Size.Small"/></MudAvatar><div style="flex:1"><MudText Typo="Typo.body2" Style="font-weight:600">@a.Title</MudText><MudText Typo="Typo.caption" Class="muted">@a.Detail</MudText></div><MudText Typo="Typo.caption" Class="muted">@a.Time</MudText></MudStack>}</MudCard></MudItem></MudGrid>
 <MudCard Elevation="0" Class="content-card pa-5 mt-5"><MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3"><MudText Typo="Typo.h6" Style="font-weight:700">Active lab sessions</MudText><MudButton Href="/sessions" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">View all</MudButton></MudStack><MudTable Items="Sessions" Hover Dense Elevation="0"><HeaderContent><MudTh>Student</MudTh><MudTh>Room / PC</MudTh><MudTh>Time In</MudTh><MudTh>Status</MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.body2" Style="font-weight:600">@context.Student</MudText><MudText Typo="Typo.caption" Class="muted">@context.StudentNo</MudText></MudTd><MudTd>@context.Location</MudTd><MudTd>@context.Time</MudTd><MudTd><MudChip Size="Size.Small" Color="Color.Success">Active</MudChip></MudTd></RowTemplate></MudTable></MudCard>
 <MudText Typo="Typo.caption" Class="muted mt-4">Design preview only — displayed records are sample data and are not connected to the LMS API.</MudText>
</div>
@code { private record Stat(string Label,string Value,string Note,string Icon); private record ActivityItem(string Title,string Detail,string Time,Color Color,string Icon); private record SessionRow(string Student,string StudentNo,string Location,string Time); private List<Stat> Stats=new(){new("Total Students","1,248","+32 this month",Icons.Material.Filled.Groups),new("Registered PCs","38","Across 6 lab rooms",Icons.Material.Filled.Computer),new("Active Sessions","8","Currently using lab PCs",Icons.Material.Filled.Schedule),new("Available Vouchers","124","Ready for distribution",Icons.Material.Filled.ConfirmationNumber)}; private List<ActivityItem> Activity=new(){new("Student time-in","Juan Dela Cruz · Lab 2 / PC 01","08:05 AM",Color.Success,Icons.Material.Filled.Login),new("Voucher generated","20 vouchers created by admin","07:55 AM",Color.Primary,Icons.Material.Filled.ConfirmationNumber),new("PC status changed","Lab 1 / PC 04 marked maintenance","Yesterday",Color.Warning,Icons.Material.Filled.Build),new("Student registered","Maria Santos · BSIT 2A","Yesterday",Color.Info,Icons.Material.Filled.PersonAdd)}; private List<SessionRow> Sessions=new(){new("Juan Dela Cruz","2024-00123","Lab 2 · PC 01","08:05 AM"),new("Maria Santos","2024-00124","Lab 1 · PC 03","08:12 AM"),new("Pedro Garcia","2024-00125","Lab 3 · PC 02","08:20 AM")}; }
