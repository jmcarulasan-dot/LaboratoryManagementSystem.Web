@page "/notifications"
@inject ApiClient Api

<div class="page-wrap">
    <PageHeader Title="Notifications" Subtitle="@(_rows.Count == 1 ? "1 alert" : $"{_rows.Count} alerts")">
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Refresh</MudButton>
    </PageHeader>

    <div class="lms-card" style="padding:8px 22px">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="my-4" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-3">@_error</MudAlert>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty">You're all caught up. No notifications yet.</div>
        }
        else
        {
            @foreach (var row in _rows)
            {
                <div class="notif-row">
                    <div class="notif-icon"><MudIcon Icon="@IconFor(JsonRow.Str(row, "title", ""))" Size="Size.Small" /></div>
                    <div>
                        <div class="notif-title">@JsonRow.Str(row, "title")</div>
                        <div class="notif-msg">@JsonRow.Str(row, "message")</div>
                    </div>
                    <div class="notif-time">@Ago(JsonRow.Date(row, "createdAt"))</div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private List<JsonElement> _rows = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var rows = await Api.GetListAsync("api/admin/notifications");
            if (rows is null) _error = "Could not load notifications. Sign in again and check that the API and database are running.";
            else _rows = rows;
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private static string IconFor(string title) =>
        title.Contains("voucher", StringComparison.OrdinalIgnoreCase) ? Icons.Material.Outlined.ConfirmationNumber
        : title.Contains("suspend", StringComparison.OrdinalIgnoreCase) || title.Contains("lock", StringComparison.OrdinalIgnoreCase) ? Icons.Material.Outlined.WarningAmber
        : title.Contains("account", StringComparison.OrdinalIgnoreCase) || title.Contains("student", StringComparison.OrdinalIgnoreCase) ? Icons.Material.Outlined.PersonOutline
        : Icons.Material.Outlined.NotificationsNone;

    private static string Ago(DateTime? date)
    {
        if (date is null) return "—";
        var span = DateTime.Now - date.Value;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hrs ago";
        if (span.TotalDays < 2) return "Yesterday";
        return JsonRow.Day(date);
    }
}
