@page "/students"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<div class="page-wrap">
    <PageHeader Title="User Management" Subtitle="Manage student accounts">
        <MudButton Href="/students/add" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add New Student</MudButton>
    </PageHeader>

    <div class="lms-card">
        <div class="toolbar">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search by name or student ID" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:340px" />
            <span class="grow"></span>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadStudents">Refresh</MudButton>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Error" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else if (Filtered.Count == 0)
        {
            <div class="empty">No students found.</div>
        }
        else
        {
            <div class="lms-table-wrap">
                <table class="lms-table">
                    <thead><tr><th>Student ID</th><th>Name</th><th>Course / Section</th><th>Email</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var row in Filtered)
                        {
                            var suspended = JsonRow.Bool(row, "isSuspended");
                            <tr>
                                <td class="mono">@JsonRow.Str(row, "studentNo")</td>
                                <td>@JsonRow.Str(row, "fullName")</td>
                                <td>@JsonRow.Str(row, "courseSection")</td>
                                <td class="muted">@JsonRow.Str(row, "email")</td>
                                <td><span class="pill @(suspended ? "pill-red" : "pill-green")">@(suspended ? "Suspended" : "Active")</span></td>
                                <td>
                                    <div class="row-actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => ResetMfa(row))">Reset MFA</MudButton>
                                        @if (suspended)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => SetSuspension(row, false))">Unsuspend</MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => SetSuspension(row, true))">Suspend</MudButton>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="muted" style="font-size:12px;margin-top:12px">Showing @Filtered.Count of @_rows.Count students</div>
        }
    </div>
</div>

@code {
    private string _search = "";
    private bool _loading = true;
    private string? _error;
    private List<JsonElement> _rows = new();

    private List<JsonElement> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _rows
        : _rows.Where(r =>
            JsonRow.Str(r, "studentNo", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "fullName", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "courseSection", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "email", "").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadStudents();

    private async Task LoadStudents()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetListAsync("api/admin/students");
            if (result is null) _error = "Could not load students. Sign in again and check that the API and database are running.";
            else _rows = result;
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task SetSuspension(JsonElement row, bool suspend)
    {
        var studentNo = JsonRow.Str(row, "studentNo", "");
        if (studentNo.Length == 0) return;
        var action = suspend ? "suspend" : "unsuspend";
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/admin/students/{Uri.EscapeDataString(studentNo)}/{action}");
            Snackbar.Add(ok ? (suspend ? "Student suspended." : "Student unsuspended.") : message, ok ? Severity.Success : Severity.Error);
            if (ok) await LoadStudents();
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
    }

    private async Task ResetMfa(JsonElement row)
    {
        var studentNo = JsonRow.Str(row, "studentNo", "");
        if (studentNo.Length == 0) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Reset authenticator?",
            "This clears the student's current authenticator. At the next sign-in they will scan a new QR code and enter a six-digit code to reconnect.",
            yesText: "Reset MFA",
            cancelText: "Keep current setup");
        if (confirmed != true) return;
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/admin/students/{Uri.EscapeDataString(studentNo)}/security/totp/reset");
            Snackbar.Add(ok ? "Authenticator reset. The student can set it up again at next sign-in." : message, ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
    }
}
