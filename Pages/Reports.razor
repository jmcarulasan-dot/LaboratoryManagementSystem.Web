@page "/reports"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api

<div class="page-wrap">
    <MudText Typo="Typo.h4" Class="page-title">Reports</MudText>
    <MudText Class="muted mt-1 mb-6">Attendance, computer usage, and voucher activity from the LMS database.</MudText>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" /> }
    else if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert> }
    <MudCard Class="content-card pa-5 mb-5" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-4">Attendance</MudText>
        <ApiDataTable Items="_attendance" Columns="_sessionColumns" EmptyMessage="No attendance records are in the database yet." />
    </MudCard>
    <MudCard Class="content-card pa-5 mb-5" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-4">Computer usage</MudText>
        <ApiDataTable Items="_usage" Columns="_sessionColumns" EmptyMessage="No computer usage records are in the database yet." />
    </MudCard>
    <MudCard Class="content-card pa-5" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-4">Voucher activity</MudText>
        <ApiDataTable Items="_vouchers" Columns="_voucherColumns" EmptyMessage="No voucher records are in the database yet." />
    </MudCard>
</div>

@code {
    private readonly string[] _sessionColumns = ["SessionID", "StudentNo", "StudentName", "RoomName", "PCName", "TimeIn", "TimeOut", "DurationMinutes"];
    private readonly string[] _voucherColumns = ["VoucherCode", "StudentNo", "StudentName", "Status", "CreatedAt", "ExpiresAt", "UsedAt"];
    private IReadOnlyCollection<JsonElement> _attendance = Array.Empty<JsonElement>();
    private IReadOnlyCollection<JsonElement> _usage = Array.Empty<JsonElement>();
    private IReadOnlyCollection<JsonElement> _vouchers = Array.Empty<JsonElement>();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var attendance = await Api.GetAsync<JsonElement>("api/admin/reports/attendance");
            var usage = await Api.GetAsync<JsonElement>("api/admin/reports/usage");
            var vouchers = await Api.GetAsync<JsonElement>("api/admin/reports/vouchers");
            if (attendance.ValueKind != JsonValueKind.Array || usage.ValueKind != JsonValueKind.Array || vouchers.ValueKind != JsonValueKind.Array)
                _error = "Reports could not be loaded. Check your admin session and the API/database connection.";
            else
            {
                _attendance = attendance.EnumerateArray().ToArray();
                _usage = usage.EnumerateArray().ToArray();
                _vouchers = vouchers.EnumerateArray().ToArray();
            }
        }
        catch (Exception ex) { _error = $"Unable to connect to the LMS API: {ex.Message}"; }
        finally { _loading = false; }
    }
}
