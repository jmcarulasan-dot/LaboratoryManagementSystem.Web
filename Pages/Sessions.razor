@page "/sessions"
@inject ApiClient Api
@inject ISnackbar Snackbar

<div class="page-wrap">
    <PageHeader Title="Lab Sessions" Subtitle="Monitor student time-in and time-out records.">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Refresh</MudButton>
    </PageHeader>

    <div class="lms-card">
        <div class="toolbar">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search student, ID or PC" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:320px" />
            <MudSwitch T="bool" @bind-Value="_activeOnly" Color="Color.Error" Label="Active only" />
        </div>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Error" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else if (Filtered.Count == 0)
        {
            <div class="empty">No sessions found.</div>
        }
        else
        {
            <div class="lms-table-wrap">
                <table class="lms-table">
                    <thead><tr><th>Student ID</th><th>Name</th><th>Room / PC</th><th>Time In</th><th>Time Out</th><th>Duration</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in Filtered)
                        {
                            var active = IsActive(row);
                            <tr>
                                <td class="mono">@JsonRow.Str(row, "studentNo")</td>
                                <td>@JsonRow.Str(row, "studentName")</td>
                                <td>@JsonRow.Str(row, "roomName") · <span class="mono">@JsonRow.Str(row, "pcName")</span></td>
                                <td>@JsonRow.When(JsonRow.Date(row, "timeIn"))</td>
                                <td>@JsonRow.When(JsonRow.Date(row, "timeOut"))</td>
                                <td>@Duration(JsonRow.Int(row, "durationMinutes"))</td>
                                <td><span class="pill @(active ? "pill-green" : "pill-gray")">@(active ? "Active" : "Completed")</span></td>
                                <td>
                                    @if (active)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => EndSession(row))">End session</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private bool _loading = true, _activeOnly;
    private string? _error;
    private string _search = "";
    private List<JsonElement> _rows = new();

    private static bool IsActive(JsonElement row) => JsonRow.Find(row, "timeOut") is not { ValueKind: not JsonValueKind.Null };

    private List<JsonElement> Filtered => _rows
        .Where(r => !_activeOnly || IsActive(r))
        .Where(r => string.IsNullOrWhiteSpace(_search) ||
            JsonRow.Str(r, "studentNo", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "studentName", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "pcName", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "roomName", "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static string Duration(int minutes) => minutes >= 60 ? $"{minutes / 60}h {minutes % 60}m" : $"{minutes}m";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var rows = await Api.GetListAsync("api/admin/sessions");
            if (rows is null) _error = "Could not load sessions. Sign in again and check that the API and database are running.";
            else _rows = rows;
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task EndSession(JsonElement row)
    {
        var id = JsonRow.Int(row, "sessionID");
        if (id <= 0) return;
        try
        {
            var (ok, message) = await Api.SendForResultAsync(HttpMethod.Put, $"api/admin/sessions/{id}/timeout");
            Snackbar.Add(ok ? "Session ended." : message, ok ? Severity.Success : Severity.Error);
            if (ok) await Load();
        }
        catch (Exception ex) { Snackbar.Add($"API request failed: {ex.Message}", Severity.Error); }
    }
}
