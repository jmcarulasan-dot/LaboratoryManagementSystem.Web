@page "/settings"
@using System.Text.Json
@inject LaboratoryManagementSystem.Web.Services.ApiClient Api
@inject ISnackbar Snackbar

<div class="page-wrap">
    <MudText Typo="Typo.h4" Class="page-title">Settings</MudText>
    <MudText Class="muted mt-1 mb-6">Your signed-in admin account and password.</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Error" Class="mb-4" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="content-card pa-5 mb-5">
            <MudText Typo="Typo.h6" Class="mb-4">Admin profile</MudText>
            <MudText><b>Name:</b> @Read("fullName", "FullName")</MudText>
            <MudText><b>Company ID:</b> @Read("companyID", "CompanyID")</MudText>
            <MudText><b>Email:</b> @Read("email", "Email")</MudText>
        </MudPaper>
        <MudPaper Elevation="0" Class="content-card pa-5">
            <MudText Typo="Typo.h6" Class="mb-4">Change password</MudText>
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_currentPassword" Label="Current password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_newPassword" Label="New password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
                <MudTextField @bind-Value="_confirmPassword" Label="Confirm new password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="ChangePassword" Class="mt-4">
                    @(_saving ? "Saving…" : "Update password")
                </MudButton>
            </MudForm>
        </MudPaper>
    }
</div>

@code {
    private MudForm? _form;
    private JsonElement _profile;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetAsync<JsonElement>("api/admin/me");
            if (result.ValueKind != JsonValueKind.Object) _error = "Your admin profile could not be loaded from the database.";
            else _profile = result;
        }
        catch (Exception ex) { _error = $"Unable to connect to the LMS API: {ex.Message}"; }
        finally { _loading = false; }
    }

    private string Read(params string[] names)
    {
        if (_profile.ValueKind != JsonValueKind.Object) return "—";
        foreach (var property in _profile.EnumerateObject())
            if (names.Contains(property.Name, StringComparer.OrdinalIgnoreCase))
                return property.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined ? "—" : property.Value.ToString();
        return "—";
    }

    private async Task ChangePassword()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("The new password and confirmation do not match.", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            var updated = await Api.SendSuccessAsync(HttpMethod.Put, "api/admin/me/password", new
            {
                currentPassword = _currentPassword,
                newPassword = _newPassword
            });
            if (updated)
            {
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                Snackbar.Add("Password updated.", Severity.Success);
            }
            else Snackbar.Add("Password could not be updated. Check your current password and the API response.", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"Unable to connect to the LMS API: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
