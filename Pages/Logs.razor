@page "/logs"
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-wrap">
    <PageHeader Title="Logs Management" Subtitle="System and session activity history">
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="Export">Export CSV</MudButton>
    </PageHeader>

    <div class="lms-card">
        <div class="toolbar">
            <MudSelect T="string" @bind-Value="_range" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px">
                <MudSelectItem T="string" Value="@("All activity")">All activity</MudSelectItem>
                <MudSelectItem T="string" Value="@("Today")">Today</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search action or details" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:320px" />
            <span class="grow"></span>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Refresh</MudButton>
        </div>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Error" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else if (Filtered.Count == 0)
        {
            <div class="empty">No log entries found.</div>
        }
        else
        {
            <div class="lms-table-wrap">
                <table class="lms-table">
                    <thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
                    <tbody>
                        @foreach (var row in Filtered)
                        {
                            <tr>
                                <td class="mono">@Stamp(row)</td>
                                <td>@Who(row)</td>
                                <td><span class="pill @ActionPill(JsonRow.Str(row, "action", ""))">@Pretty(JsonRow.Str(row, "action", ""))</span></td>
                                <td class="muted">@JsonRow.Str(row, "description")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="muted" style="text-align:center;font-size:12px;margin-top:14px">Showing @Filtered.Count of @_rows.Count log entries</div>
        }
    </div>
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = "", _range = "All activity";
    private List<JsonElement> _rows = new();

    private List<JsonElement> Filtered => _rows
        .Where(r => _range != "Today" || JsonRow.Date(r, "createdAt")?.Date == DateTime.Today)
        .Where(r => string.IsNullOrWhiteSpace(_search) ||
            JsonRow.Str(r, "action", "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            JsonRow.Str(r, "description", "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static string Stamp(JsonElement row)
    {
        var date = JsonRow.Date(row, "createdAt");
        if (date is null) return "—";
        var day = date.Value.Date == DateTime.Today ? "Today" : date.Value.Date == DateTime.Today.AddDays(-1) ? "Yesterday" : JsonRow.Day(date);
        return $"{day}, {JsonRow.Time(date)}";
    }

    private static string Who(JsonElement row) =>
        JsonRow.Int(row, "adminID") > 0 ? "Admin" : JsonRow.Int(row, "studentID") > 0 ? "Student" : "System";

    private static string Pretty(string action) =>
        action.Length == 0 ? "—" : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(action.Replace('_', ' ').ToLowerInvariant());

    private static string ActionPill(string action) =>
        action.Contains("START", StringComparison.OrdinalIgnoreCase) || action.Contains("TIME_IN", StringComparison.OrdinalIgnoreCase) ? "pill-green"
        : action.Contains("SUSPEND", StringComparison.OrdinalIgnoreCase) || action.Contains("CANCEL", StringComparison.OrdinalIgnoreCase) || action.Contains("FAIL", StringComparison.OrdinalIgnoreCase) || action.Contains("LOCK", StringComparison.OrdinalIgnoreCase) ? "pill-red"
        : "pill-gray";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var rows = await Api.GetListAsync("api/admin/logs");
            if (rows is null) _error = "Could not load logs. Sign in again and check that the API and database are running.";
            else _rows = rows;
        }
        catch (Exception ex) { _error = $"API connection failed: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task Export()
    {
        var csv = JsonRow.Csv(
            new[] { "Timestamp", "User", "Action", "Details" },
            Filtered.Select(r => (IEnumerable<string>)new[] { Stamp(r), Who(r), JsonRow.Str(r, "action", ""), JsonRow.Str(r, "description", "") }));
        await Js.InvokeVoidAsync("lmsDownload", $"logs-{DateTime.Today:yyyyMMdd}.csv", csv);
    }
}
